<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>MetaBrain.S1T4.Smoke</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- S6-T5 renders the real WPF owner window offscreen for visual proof.
         Only the S6-T5 render helper touches presentation types; the suite
         itself stays a console program. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <!-- The suite drives the owner console session in process (the exact class
         the WPF window uses) for the S5-T2/S5-T3 private-state lock boundary.
         That session type owns no WPF surface, so this project keeps its plain
         console implicit usings. -->
    <ProjectReference Include="..\..\src\MetaBrain.Connections\MetaBrain.Connections.csproj" />
    <ProjectReference Include="..\..\src\MetaBrain.OwnerUi\MetaBrain.OwnerUi.csproj" />
  </ItemGroup>
</Project>
