<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>MetaBrain.Cli</AssemblyName>
    <RootNamespace>MetaBrain.Cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- The product CLI is a front over the shared lifecycle and owner
         commands in Connections. It owns no domain or policy code, and it
         reaches the vault only over the owner control pipe like every other
         frontend. -->
    <ProjectReference Include="..\MetaBrain.Connections\MetaBrain.Connections.csproj" />
  </ItemGroup>
</Project>
