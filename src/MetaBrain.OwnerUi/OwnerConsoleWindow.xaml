                                     AutomationProperties.AutomationId="ProviderBaseUrlInput" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="API key" Foreground="#FF6B7280" />
                            <PasswordBox Grid.Row="1" Grid.Column="3" x:Name="ProviderKeyInput"
                                         AutomationProperties.AutomationId="ProviderKeyInput" />
                        </Grid>
