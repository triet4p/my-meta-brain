                            <Button x:Name="ProviderReadButton" Content="Read model settings" Padding="14,7" Margin="8,0,0,0" Click="OnProviderReadClicked" />
                        </StackPanel>
                        <TextBlock x:Name="ProviderSettingsText" TextWrapping="Wrap" Margin="0,8,0,0" FontFamily="Consolas" />
                        <TextBlock x:Name="ProviderMessageText" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" />

                        <TextBlock Text="Selection (explicit: you pick each note and the service pins its live revision)" FontWeight="SemiBold" Margin="0,18,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Profile" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="JobsProfileInput" Margin="0,0,10,6"
                                      AutomationProperties.AutomationId="JobsProfileInput" SelectionChanged="OnJobsProfileChanged" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Level" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <ComboBox Grid.Row="0" Grid.Column="3" x:Name="JobsLevelInput" Margin="0,0,0,6"
                                      AutomationProperties.AutomationId="JobsLevelInput" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Objective" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="JobsObjectiveInput" Margin="0,0,0,6"
                                     AutomationProperties.AutomationId="JobsObjectiveInput" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Destination zone" Foreground="#FF6B7280" />
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="JobsZoneInput" Margin="0,0,10,0"
                                      IsEditable="True" AutomationProperties.AutomationId="JobsZoneInput" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Destination ID" Foreground="#FF6B7280" />
                            <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                                <TextBox x:Name="JobsDestinationInput" Width="170"
                                         AutomationProperties.AutomationId="JobsDestinationInput" />
                                <Button x:Name="JobsDestinationUseLibraryButton" Content="Use open item" Padding="10,7" Margin="8,0,0,0" Click="OnJobsDestinationUseLibraryClicked" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Destination revision (from open item)" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="JobsDestinationRevisionInput" Margin="0,0,10,6"
                                     AutomationProperties.AutomationId="JobsDestinationRevisionInput" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Interval (min)" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="ScheduleIntervalInput" Margin="0,0,0,6"
                                     AutomationProperties.AutomationId="ScheduleIntervalInput" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Provider / model" Foreground="#FF6B7280" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="JobsProviderInput" Margin="0,0,10,0"
                                     AutomationProperties.AutomationId="JobsProviderInput" />
                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="JobsModelInput"
                                     AutomationProperties.AutomationId="JobsModelInput" />
                        </Grid>
                        <TextBlock Text="Inputs the job may read (added from the service, never typed)" Foreground="#FF6B7280" Margin="0,8,0,2" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Foreground="#FF6B7280"
                                   Text="Add inputs from what the service already showed you: each entry pins the live revision the service served. The list is the selection; remove an entry to narrow it." />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button x:Name="JobsAddLibraryButton" Content="Add open library item" Padding="14,7" Click="OnJobsAddLibraryClicked" />
                            <Button x:Name="JobsAddCaptureButton" Content="Add saved capture" Padding="14,7" Margin="8,0,0,0" Click="OnJobsAddCaptureClicked" />
                            <Button x:Name="JobsRemoveInputButton" Content="Remove selected input" Padding="14,7" Margin="8,0,0,0" Click="OnJobsRemoveInputClicked" />
                        </StackPanel>
                        <ListBox x:Name="JobsInputsList" Height="70" Background="White" BorderBrush="#FFD5D8DC"
                                 AutomationProperties.AutomationId="JobsInputsList" SelectionMode="Extended"
                                 SelectionChanged="OnJobsInputSelectionChanged" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="JobsRunButton" Content="Run one job" Padding="14,7" Click="OnJobsRunClicked" />
                            <Button x:Name="JobsBatchButton" Content="Run batch (one job per input)" Padding="14,7" Margin="8,0,0,0" Click="OnJobsBatchClicked" />
                            <Button x:Name="JobsRefreshButton" Content="Refresh jobs" Padding="14,7" Margin="8,0,0,0" Click="OnJobsRefreshClicked" />
                            <Button x:Name="JobsCancelButton" Content="Cancel selected job" Padding="14,7" Margin="8,0,0,0" Click="OnJobsCancelClicked" />
                            <Button x:Name="JobsSpendButton" Content="Spend ledger" Padding="14,7" Margin="8,0,0,0" Click="OnJobsSpendClicked" />
                        </StackPanel>
                        <TextBlock x:Name="JobsMessageText" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold" />
                        <TextBlock x:Name="BatchMessageText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF6B7280" />
                        <ListBox x:Name="JobsList" Height="120" Margin="0,8,0,0" Background="White" BorderBrush="#FFD5D8DC"
                                 AutomationProperties.AutomationId="JobsList" SelectionChanged="OnJobsSelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 KeyDown="OnJobsListKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="JobDetailText" TextWrapping="Wrap" Margin="0,8,0,0" FontFamily="Consolas" />
                        <TextBlock x:Name="SpendText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FF6B7280" />

                        <TextBlock Text="Synthesis schedule (disabled until you enable it)" FontWeight="SemiBold" Margin="0,18,0,0" />
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="The schedule runs the same explicit selection, objective and level configured above, with the interval and provider/model you set. It runs only while the vault is unlocked; locking pauses it instead of unlocking anything, and a slot missed while locked or while the service was down is never replayed as extra runs. Every scheduled run is one bounded job whose output is pending proposals — never a publication, a resolution or a change to what you believe." />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="ScheduleEnableButton" Content="Enable schedule" Padding="14,7" Click="OnScheduleEnableClicked" />
                            <Button x:Name="ScheduleDisableButton" Content="Disable schedule" Padding="14,7" Margin="8,0,0,0" Click="OnScheduleDisableClicked" />
                            <Button x:Name="ScheduleRefreshButton" Content="Read schedule" Padding="14,7" Margin="8,0,0,0" Click="OnScheduleRefreshClicked" />
                        </StackPanel>
                        <TextBlock x:Name="ScheduleStateText" TextWrapping="Wrap" Margin="0,8,0,0" FontFamily="Consolas" />
                        <TextBlock x:Name="ScheduleMessageText" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" />

                        <TextBlock Text="Boundary facts and limits" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Saving a note or reading it back calls no model: the capture screen writes one encrypted source, and only a run you start here reaches a provider." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Every job is bounded before send: exact provider/model pricing, 10,000 input tokens, 2,000 output tokens, $0.25 per job and $5.00 rolling 30 days. An unknown price or context refuses instead of sending." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Model output is validated and committed only as pending proposals in the destination inbox: nothing here publishes, confirms, resolves a question or rewrites a conclusion." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• A batch is one bounded job per selected note, not a wider job: each note keeps its own state and its own cost, and a refusal on one note leaves the others to you." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• The schedule is one encrypted record you can read back and disable. Disabling stops future runs; it does not retract context already sent to a provider, and it does not undo a proposal already committed." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Keyboard: Enter reads the selected job, F5 refreshes the job list, Ctrl+L locks the vault." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Privacy: this view holds no on-disk cache and never shows the API key. Locking the vault (or losing the service, or ending the session) clears every job, schedule and spend view above, and an answer already in flight is discarded instead of restoring them." />
                    </StackPanel>
                    <StackPanel x:Name="IntentionsPanel" Visibility="Collapsed">
                        <TextBlock Text="Intentions — scheduled and due" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Create or edit a one-time time trigger for an intention you pick, or cancel that trigger without completing the intention. An owner-enabled project/task context trigger surfaces a reminder only when the brief caller explicitly supplies the same configured context and the intention ID/revision is already in that session's approved scope. No context is inferred and scope never grows. The console converts the date and time you choose into one exact UTC instant with the offset you selected; date-only values, named zones and recurring schedules stay unsupported. The owner-only view is the time-notification surface while unlocked; the background scheduler makes no LLM/provider calls." />
                        <TextBlock Text="The service pauses private scheduling and due-list reads while locked, stores no key, and never unlocks for a deadline. Unlock is always your explicit act. Due/context reminders, notification, acknowledgement and completion are separate; reading or acknowledging never completes an intention." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF6B7280" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="IntentionsRefreshButton" Content="Read scheduled intentions" Padding="14,7" Click="OnIntentionsRefreshClicked" />
                        </StackPanel>
                        <TextBlock x:Name="IntentionsMessageText" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" />
                        <ListBox x:Name="IntentionsList" Height="210" Margin="0,8,0,0" Background="White" BorderBrush="#FFD5D8DC"
                                 AutomationProperties.AutomationId="IntentionsList" SelectionChanged="OnIntentionsSelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 KeyDown="OnIntentionsListKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding BodyPreview}" Foreground="#FF6B7280" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="One-time time trigger (choose the intention, then a local date and time)" FontWeight="SemiBold" Margin="0,18,0,0" />
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF6B7280"
                                   Text="Search for the pending intention, then choose the date and time you mean. Your local time zone is used only when you pick the local option, and the exact UTC instant is shown before you send. No resource ID has to be typed or remembered." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox x:Name="IntentionSearchInput" Width="360"
                                     AutomationProperties.AutomationId="IntentionSearchInput" />
                            <Button x:Name="IntentionSearchButton" Content="Find intentions" Padding="14,7" Margin="8,0,0,0" Click="OnIntentionSearchClicked" />
                            <Button x:Name="IntentionUseSelectedButton" Content="Use selected schedule row" Padding="14,7" Margin="8,0,0,0" Click="OnIntentionUseSelectedClicked" />
                        </StackPanel>
                        <TextBlock x:Name="IntentionSearchMessageText" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" />
                        <ListBox x:Name="IntentionCandidatesList" Height="84" Margin="0,6,0,0" Background="White" BorderBrush="#FFD5D8DC"
                                 AutomationProperties.AutomationId="IntentionCandidatesList"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnIntentionCandidateSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Chosen intention" Foreground="#FF6B7280" Margin="0,10,0,0" />
                        <TextBox x:Name="IntentionChosenText" IsReadOnly="True" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="IntentionChosenText" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Due date / time" Foreground="#FF6B7280" VerticalAlignment="Center" />
                            <DatePicker Grid.Column="1" x:Name="IntentionDateInput"
                                        AutomationProperties.AutomationId="IntentionDateInput"
                                        SelectedDateChanged="OnIntentionTimeInputChanged" />
                            <TextBox Grid.Column="2" x:Name="IntentionTimeInput" Margin="8,0,0,0"
                                     AutomationProperties.AutomationId="IntentionTimeInput"
                                     TextChanged="OnIntentionTimeTextChanged" />
                            <ComboBox Grid.Column="3" x:Name="IntentionZoneInput" Margin="8,0,0,0"
                                      AutomationProperties.AutomationId="IntentionZoneInput"
                                      SelectionChanged="OnIntentionZoneChanged" />
                        </Grid>
                        <TextBlock x:Name="IntentionDuePreviewText" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold"
                                   AutomationProperties.AutomationId="IntentionDuePreviewText" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="IntentionTriggerSetButton" Content="Create / reschedule trigger" Padding="14,7" Click="OnIntentionTriggerSetClicked" />
                            <Button x:Name="IntentionTriggerCancelButton" Content="Cancel trigger" Padding="14,7" Margin="8,0,0,0" Click="OnIntentionTriggerCancelClicked" />
                        </StackPanel>
                        <TextBlock Text="Project/task context trigger (exact owner-selected labels)" FontWeight="SemiBold" Margin="0,18,0,0" />
                        <TextBlock Text="A caller must explicitly name each configured project/task context. Only an enabled pending intention at its exact approved ID/revision can appear; a new item, membership or revision never enters an existing grant. Disabling stops future matches while retaining the labels for owner review." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF6B7280" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Project context" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="IntentionContextProjectInput" Margin="0,0,0,6"
                                     AutomationProperties.AutomationId="IntentionContextProjectInput" TextChanged="OnIntentionInputChanged" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Task context" Foreground="#FF6B7280" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="IntentionContextTaskInput"
                                     AutomationProperties.AutomationId="IntentionContextTaskInput" TextChanged="OnIntentionInputChanged" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="IntentionContextTriggerSetButton" Content="Enable / update context trigger" Padding="14,7" Click="OnIntentionContextTriggerSetClicked" />
                            <Button x:Name="IntentionContextTriggerDisableButton" Content="Disable context trigger" Padding="14,7" Margin="8,0,0,0" Click="OnIntentionContextTriggerDisableClicked" />
                        </StackPanel>
                        <TextBlock Text="Owner act (acknowledgement never marks done)" FontWeight="SemiBold" Margin="0,18,0,0" />
                        <TextBlock Text="Acknowledge records that you saw the due or context reminder. Complete or cancel changes the intention only after the separate action below; an explicit rationale is recorded for those state changes." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF6B7280" />
                        <TextBox x:Name="IntentionRationaleInput" Margin="0,8,0,0" Height="52" AcceptsReturn="True" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="IntentionRationaleInput" TextChanged="OnIntentionInputChanged" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="IntentionAcknowledgeButton" Content="Acknowledge reminder" Padding="14,7" Click="OnIntentionAcknowledgeClicked" />
                            <Button x:Name="IntentionCompleteButton" Content="Complete intention" Padding="14,7" Margin="8,0,0,0" Click="OnIntentionCompleteClicked" />
                            <Button x:Name="IntentionCancelButton" Content="Cancel intention" Padding="14,7" Margin="8,0,0,0" Click="OnIntentionCancelClicked" />
                        </StackPanel>
                        <TextBlock Text="Privacy and interaction" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• The service reads/writes encrypted lifecycle records only in an unlocked vault operation. Locked requests return no private trigger metadata or content; no title, body, due instant, project/task context or acknowledgement is sent to a notification surface while locked." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• A missed deadline remains due across offline time, service restart and lock; after explicit unlock the scheduler records one notification marker. A matching project/task appears only inside a brief whose existing session snapshot contains its exact current intention revision. Reading or acknowledging a time/context reminder never completes it; the owner must separately complete with a rationale." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Keyboard: Enter opens the selected row, F5 reads the due list, Ctrl+L locks the vault." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Privacy: this view holds no on-disk cache. Locking, service loss or ending the owner session clears the list, private due/context text and controls; nothing automatically unlocks the vault." />
                    </StackPanel>

                    <StackPanel x:Name="ReviewQueuePanel" Visibility="Collapsed">
                        <TextBlock Text="Review queue — due, stale and unavailable evidence" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="The service evaluates your vault and reports what asks for your attention: an item whose review-after deadline has passed, an item whose cited source moved past the revision the item cited, a cited source that is gone, and a cited source that states it is unavailable. A source nobody asserted anything about stays unknown, and a deadline known only as a year stays a year: nothing is narrowed into a date that was never recorded." />
                        <TextBlock Text="A moved, missing or unavailable source is a fact about the evidence, not a verdict about the item. Recording a review says that you looked; the item keeps its own text, evidence level, citations and state, and nothing here completes an intention or denies a belief." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF6B7280" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="ReviewQueueRefreshButton" Content="Read review queue" Padding="14,7" Click="OnReviewRefreshClicked" />
                        </StackPanel>
                        <TextBlock x:Name="ReviewQueueMessageText" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" AutomationProperties.AutomationId="ReviewQueueMessageText" />
                        <ListBox x:Name="ReviewQueueList" Height="210" Margin="0,8,0,0" Background="White" BorderBrush="#FFD5D8DC"
                                 AutomationProperties.AutomationId="ReviewQueueList" SelectionChanged="OnReviewSelectionChanged"
                                 KeyDown="OnReviewListKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding BodyPreview}" Foreground="#FF6B7280" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border x:Name="ReviewQueueDetailPanel" Margin="0,14,0,0" Padding="14" Background="White"
                                BorderBrush="#FFD5D8DC" BorderThickness="1" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="Selected item (exactly as the service served it)" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock x:Name="ReviewQueueDetailText" TextWrapping="Wrap" Margin="0,8,0,0" FontFamily="Consolas" />
                                <TextBlock x:Name="ReviewQueueCitationsText" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" />
                                <TextBlock Text="Why you reviewed it" FontWeight="SemiBold" Margin="0,12,0,2" />
                                <TextBox x:Name="ReviewQueueRationaleInput" Margin="0,0,0,0" Height="48" AcceptsReturn="True" TextWrapping="Wrap"
                                         AutomationProperties.AutomationId="ReviewQueueRationaleInput" TextChanged="OnReviewInputChanged" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="ReviewQueueRecordButton" Content="Record my review" Padding="14,7" Click="OnReviewRecordClicked" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Privacy and interaction" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• The queue is computed by the service from your own encrypted vault. Nothing outside the vault is read: no enrolled source file is opened, nothing is polled, and no provider or network call happens on this screen." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Recording a review stores your reason in your private encrypted review state. It never rewrites the item, never changes its evidence level, never touches a grant, a collection or a session scope, and it never marks an intention done." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Locking, losing the service or ending the owner session clears this view and its controls. Your recorded reviews stay in the vault and come back with the next read." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Keyboard: Enter opens the selected row, F5 reads the queue again, Ctrl+L locks the vault." />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
