                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="SnapshotSourceRevisionInput" Margin="0,0,0,6"
                                     AutomationProperties.AutomationId="SnapshotSourceRevisionInput" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Retain until (UTC)" Foreground="#FF6B7280" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SnapshotRetainPresetInput" Margin="0,0,10,6"
                                      AutomationProperties.AutomationId="SnapshotRetainPresetInput"
                                      SelectionChanged="OnSnapshotRetainPresetChanged" />
