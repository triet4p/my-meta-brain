                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Locator file" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="MappingLocatorInput" Margin="0,0,0,6"
