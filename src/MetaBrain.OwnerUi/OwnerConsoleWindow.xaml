                                 SelectionChanged="OnSnapshotsSelectionChanged" KeyDown="OnSnapshotsListKeyDown" />
                        <TextBlock x:Name="SnapshotDetailText" TextWrapping="Wrap" Margin="0,8,0,0" FontFamily="Consolas" />
                        <Grid Margin="0,8,0,0">
