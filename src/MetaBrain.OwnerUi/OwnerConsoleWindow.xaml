                        <TextBlock Text="Preserved snapshots (explicit opt-in — never automatic)" FontWeight="SemiBold" Margin="0,22,0,0" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF6B7280"
                                   Text="Preservation freezes one generation's exact bytes with the source reference revision, the generation anchor and a retention you choose. The reference is the registry record of the enrolled locator you name below: register it first (revision 1), then preserve from the revision it reports. A retention is always an explicit future UTC instant. Snapshot content itself is never shown here." />
                        <TextBlock Text="Reference of the selected source (registry record preservation freezes)" FontWeight="SemiBold" Margin="0,14,0,0" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF6B7280"
                                   Text="Name the enrolled locator file of the selected source exactly as it was enrolled. The service stores revision 1 of its registry reference with the live availability it observes; only your explicit act registers it, and the locator travels only in that request and is never echoed back." />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
