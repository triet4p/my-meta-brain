<Window x:Class="MetaBrain.OwnerUi.OwnerConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meta Brain — Owner console"
        Width="1020" Height="720" MinWidth="940" MinHeight="620"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFF6F7F9"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <DockPanel>
        <Border x:Name="StateBanner" DockPanel.Dock="Top" Padding="16,12" Background="#FF6B7280">
            <StackPanel>
                <TextBlock x:Name="StateHeadline" Foreground="White" FontSize="17" FontWeight="SemiBold"
                           TextWrapping="Wrap" Text="No owner session" />
                <TextBlock x:Name="StateDetail" Foreground="#FFF1F2F4" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="12,6" Background="#FFECEDEF"
                BorderBrush="#FFD5D8DC" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#FF3F4650" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFEDEFF2" BorderBrush="#FFD5D8DC" BorderThickness="0,0,1,0" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="OWNER WORKBENCH" FontSize="11" FontWeight="SemiBold"
                               Foreground="#FF6B7280" Margin="2,0,0,8" />
                    <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="11" Foreground="#FF6B7280" Margin="2,12,2,0"
                               Text="Only delivered views appear here. This host ships no placeholder screen and no control without a real backing operation." />
                    <ListBox x:Name="Navigation" BorderThickness="0" Background="Transparent" Height="260"
                             SelectionChanged="OnNavigationChanged">
                        <ListBoxItem Content="Owner session" Padding="8,6" />
                        <ListBoxItem Content="Vault status" Padding="8,6" />
                        <ListBoxItem Content="Vault &amp; key" Padding="8,6" />
                        <ListBoxItem Content="Library" Padding="8,6" />
                        <ListBoxItem Content="Inbox" Padding="8,6" />
                        <ListBoxItem Content="Relations" Padding="8,6" />
                        <ListBoxItem Content="Sharing" Padding="8,6" />
                        <ListBoxItem Content="Sources" Padding="8,6" />
                        <ListBoxItem Content="Jobs" Padding="8,6" />
                        <ListBoxItem Content="Intentions" Padding="8,6" />
                        <ListBoxItem Content="Review queue" Padding="8,6" />
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="ContentScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="18,16,18,16">
                <Grid>
                    <StackPanel x:Name="OwnerSessionPanel">
                        <TextBlock Text="Owner session" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="This console holds no vault key and never opens or writes a vault file. Every value below is an answer of the running service on the owner control pipe, which derives owner authority from this Windows account's token and ignores identity-shaped fields in the request body." />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Control pipe" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ControlPipeText" Margin="0,0,0,6" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Owner Windows account" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="OwnerAccountText" Margin="0,0,0,6" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Session state" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SessionStateText" Margin="0,0,0,6" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Protocol revision" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ProtocolText" Margin="0,0,0,6" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Last check" Foreground="#FF6B7280" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="LastCheckText" TextWrapping="Wrap" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="ConnectButton" Content="Connect to service" Padding="14,7" Click="OnConnectClicked" />
                            <Button x:Name="CheckButton" Content="Check again" Padding="14,7" Margin="8,0,0,0" Click="OnCheckClicked" />
                            <Button x:Name="DetachButton" Content="End session" Padding="14,7" Margin="8,0,0,0" Click="OnDetachClicked" />
                        </StackPanel>

                        <TextBlock Text="Boundary facts" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Owner authority comes only from this Windows account's connection to the owner control pipe." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Request body fields, an Origin/localhost claim, or an agent-supplied owner claim never grant owner authority." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• This application opens no listening socket, so no localhost endpoint can act as the owner through it." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Limit: another process running as this same Windows account can control this application or read its memory. This host does not claim protection from same-account processes." />

                        <TextBlock Text="Session activity (this process only)" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <ListBox x:Name="ActivityList" Height="150" Background="White" BorderBrush="#FFD5D8DC" />
                    </StackPanel>

                    <StackPanel x:Name="VaultStatusPanel" Visibility="Collapsed">
                        <TextBlock Text="Vault status" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="The service owns the vault. This console only reports the state the service returned and what that state means for private workbench views; it never reads, decrypts or caches private content, and an unknown state is never treated as unlocked." />

                        <TextBlock x:Name="VaultStateText" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock x:Name="VaultStateDetail" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock x:Name="VaultRawText" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="#FF6B7280" />
                    </StackPanel>

                    <StackPanel x:Name="VaultKeyPanel" Visibility="Collapsed">
                        <TextBlock Text="Vault &amp; key" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Unlock, lock and key recovery are your explicit acts. This console sends the credential you type to the running service over the owner control pipe in one request; the service owns the vault, the key and the lock lifecycle. This console never unlocks by itself, never keeps a key, and never derives or replaces a key." />

                        <TextBlock Text="Service reports" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock x:Name="VaultKeyStateText" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="16" />

                        <TextBlock x:Name="VaultActStateText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FF6B7280" />

                        <TextBlock x:Name="SensitiveStateText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FF6B7280" />

                        <Border x:Name="ProvisionPanel" Margin="0,16,0,0" Padding="14" Background="White"
                                BorderBrush="#FFD5D8DC" BorderThickness="1" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="Create the owner vault" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="No vault exists for this configuration yet. Choose a passphrase of at least 12 characters. The service derives the key from it and returns a recovery key once; keep that recovery key outside this machine and outside the vault." />
                                <TextBlock Text="Passphrase" Margin="0,10,0,2" Foreground="#FF6B7280" />
                                <PasswordBox x:Name="ProvisionPassphraseInput" Width="360" HorizontalAlignment="Left"
                                             AutomationProperties.AutomationId="ProvisionPassphraseInput"
                                             PasswordChanged="OnSecretFieldChanged" />
                                <TextBlock Text="Repeat passphrase" Margin="0,8,0,2" Foreground="#FF6B7280" />
                                <PasswordBox x:Name="ProvisionConfirmInput" Width="360" HorizontalAlignment="Left"
                                             AutomationProperties.AutomationId="ProvisionConfirmInput"
                                             PasswordChanged="OnSecretFieldChanged" />
                                <TextBlock x:Name="ProvisionHintText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FF6B7280" />
                                <Button x:Name="ProvisionButton" Content="Provision owner key" Padding="14,7"
                                        Margin="0,10,0,0" HorizontalAlignment="Left" Click="OnProvisionClicked" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="RecoveryPanel" Margin="0,16,0,0" Padding="14" Background="#FFFFF7E6"
                                BorderBrush="#FFE0B44A" BorderThickness="1" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="Recovery key — shown once" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock x:Name="RecoveryGuidanceText" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="No recovery key is on screen. The service returns it once, right after provisioning, and this console stored none: if you did not save it then, it cannot be shown again." />
                                <TextBlock x:Name="RecoveryKeyText" Margin="0,10,0,0" FontFamily="Consolas" FontSize="14"
                                           TextWrapping="Wrap" AutomationProperties.AutomationId="RecoveryKeyText" />
                                <Button x:Name="HideRecoveryButton" Content="I saved it — hide from screen" Padding="14,7"
                                        Margin="0,10,0,0" HorizontalAlignment="Left" Click="OnHideRecoveryClicked" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="UnlockPanel" Margin="0,16,0,0" Padding="14" Background="White"
                                BorderBrush="#FFD5D8DC" BorderThickness="1" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="Unlock or recover the vault" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Unlocking opens the vault the service already holds; it never creates, resets or replaces a vault. A wrong or missing key leaves the vault locked." />
                                <TextBlock Text="Passphrase" Margin="0,10,0,2" Foreground="#FF6B7280" />
                                <PasswordBox x:Name="UnlockPassphraseInput" Width="360" HorizontalAlignment="Left"
                                             AutomationProperties.AutomationId="UnlockPassphraseInput"
                                             PasswordChanged="OnSecretFieldChanged" />
                                <Button x:Name="UnlockButton" Content="Unlock vault" Padding="14,7"
                                        Margin="0,10,0,0" HorizontalAlignment="Left" Click="OnUnlockClicked" />
                                <TextBlock Text="Recovery key (only if you saved it)" Margin="0,14,0,2" Foreground="#FF6B7280" />
                                <PasswordBox x:Name="RecoveryInput" Width="360" HorizontalAlignment="Left"
                                             AutomationProperties.AutomationId="RecoveryInput"
                                             PasswordChanged="OnSecretFieldChanged" />
                                <Button x:Name="RecoverButton" Content="Unlock with recovery key" Padding="14,7"
                                        Margin="0,10,0,0" HorizontalAlignment="Left" Click="OnRecoverClicked" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="LockPanel" Margin="0,16,0,0" Padding="14" Background="White"
                                BorderBrush="#FFD5D8DC" BorderThickness="1" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="Lock the vault" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Locking asks the service to drain in-flight private operations, clear the key, invalidate pending tokens and live sessions and stop private reads, ingestion and jobs. This console then clears the credential fields and any recovery key it was still showing. The next service start is locked again." />
                                <Button x:Name="LockButton" Content="Lock vault now" Padding="14,7"
                                        Margin="0,10,0,0" HorizontalAlignment="Left" Click="OnLockClicked" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="VaultMessageText" TextWrapping="Wrap" Margin="0,16,0,0" FontWeight="SemiBold" />

                        <TextBlock Text="Recovery guidance and limits" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• You keep the recovery key, not this application: store it outside this machine, outside the vault and outside any agent chat, prompt, config or log." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• If both the passphrase and the recovery key are lost, the encrypted data cannot be opened again. There is no reset, no backdoor, no administrator override and no automatic unlock in this product; nothing on this screen can bring it back." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Unlock is always your explicit act on this screen. No timer, restart, service, job or agent request unlocks the vault, and a locked vault serves no private content." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Limit — memory erasure: the credential you type exists as managed .NET/WPF strings in this process while the request is built and sent, and clearing this screen does not promise that every managed-memory copy or an OS memory dump is erased. This console makes no secure-erasure claim." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Limit — same Windows account: a process running as this account can control this console or read its memory while the vault is unlocked. Encryption protects data at rest; it is not a sandbox against your own account." />
                    </StackPanel>

                    <StackPanel x:Name="LibraryPanel" Visibility="Collapsed">
                        <TextBlock Text="Library" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Search and browse your own unlocked vault: the service searches, filters, ranks and cites, and this console only shows that answer with the exact IDs, revisions and statuses it received. A collection or zone filter narrows this search; it never widens what your vault holds and never grants anything to anyone else. Full text of an item stays on the detail read, and the private views below are dropped the moment the vault is locked." />

                        <TextBlock Text="Service reports" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock x:Name="LibraryStateText" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="16" />
                        <TextBlock x:Name="LibraryIndexText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF6B7280" />

                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF6B7280"
                                   Text="A zone is a permission boundary: it decides whose eyes may hold an item. A collection is your own folder label: it organizes, never permits. Pick both from what the service already named — or type a new zone for a new boundary." />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Search text" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="LibraryQueryInput" Margin="0,0,10,6"
                                     AutomationProperties.AutomationId="LibraryQueryInput" KeyDown="OnLibraryQueryKeyDown" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Zone" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <ComboBox Grid.Row="0" Grid.Column="3" x:Name="LibraryZoneInput" Margin="0,0,0,6"
                                      IsEditable="True" AutomationProperties.AutomationId="LibraryZoneInput" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Collection" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="LibraryCollectionInput" Margin="0,0,10,6"
                                      IsEditable="True" AutomationProperties.AutomationId="LibraryCollectionInput" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Kind" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <ComboBox Grid.Row="1" Grid.Column="3" x:Name="LibraryKindInput" Margin="0,0,0,6"
                                      AutomationProperties.AutomationId="LibraryKindInput" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Level" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="LibraryLevelInput" Margin="0,0,10,6"
                                      AutomationProperties.AutomationId="LibraryLevelInput" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Show" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <ComboBox Grid.Row="2" Grid.Column="3" x:Name="LibraryCurrentInput" Margin="0,0,0,6"
                                      AutomationProperties.AutomationId="LibraryCurrentInput" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="From (UTC)" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="LibraryFromInput" Margin="0,0,10,6"
                                     AutomationProperties.AutomationId="LibraryFromInput" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="To (UTC)" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBox Grid.Row="3" Grid.Column="3" x:Name="LibraryToInput" Margin="0,0,0,6"
                                     AutomationProperties.AutomationId="LibraryToInput" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="As of (UTC)" Foreground="#FF6B7280" />
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="LibraryAsOfInput" Margin="0,0,10,0"
                                     AutomationProperties.AutomationId="LibraryAsOfInput" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="" Foreground="#FF6B7280" />
                            <TextBlock Grid.Row="4" Grid.Column="3" Text="Current + as-of replays history" Foreground="#FF6B7280" TextWrapping="Wrap" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="LibrarySearchButton" Content="Search library" Padding="14,7" Click="OnLibrarySearchClicked" />
                            <Button x:Name="LibraryResetButton" Content="Reset filters" Padding="14,7" Margin="8,0,0,0" Click="OnLibraryResetClicked" />
                            <Button x:Name="LibraryRebuildButton" Content="Rebuild library index" Padding="14,7" Margin="8,0,0,0" Click="OnLibraryRebuildClicked" />
                            <TextBlock Text="Page size" Foreground="#FF6B7280" VerticalAlignment="Center" Margin="16,0,6,0" />
                            <ComboBox x:Name="LibraryPageSizeInput" Width="70" AutomationProperties.AutomationId="LibraryPageSizeInput" SelectionChanged="OnLibraryPageSizeChanged" />
                            <Button x:Name="LibraryPreviousButton" Content="Previous page" Padding="14,7" Margin="8,0,0,0" Click="OnLibraryPreviousClicked" />
                            <Button x:Name="LibraryNextButton" Content="Next page" Padding="14,7" Margin="8,0,0,0" Click="OnLibraryNextClicked" />
                            <CheckBox x:Name="LibraryIncludeArchivedInput" Margin="16,0,0,0" VerticalAlignment="Center"
                                      Content="Include items I set aside in this search"
                                      AutomationProperties.AutomationId="LibraryIncludeArchivedInput" />
                        </StackPanel>

                        <TextBlock x:Name="LibraryMessageText" TextWrapping="Wrap" Margin="0,12,0,0" FontWeight="SemiBold" />
                        <TextBlock x:Name="LibraryPageText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FF6B7280" />

                        <ListBox x:Name="LibraryResults" Height="170" Margin="0,8,0,0" Background="White" BorderBrush="#FFD5D8DC"
                                 AutomationProperties.AutomationId="LibraryResults"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnLibraryResultChanged" KeyDown="OnLibraryResultsKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border x:Name="LibraryDetailPanel" Margin="0,14,0,0" Padding="14" Background="White"
                                BorderBrush="#FFD5D8DC" BorderThickness="1" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="Evidence detail (the exact revision the service served)" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock x:Name="LibraryDetailSummaryText" TextWrapping="Wrap" Margin="0,8,0,0" FontFamily="Consolas" />
                                <TextBlock x:Name="LibraryDetailTitleText" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBox x:Name="LibraryTitleInput" Width="360" VerticalContentAlignment="Center"
                                             AutomationProperties.AutomationId="LibraryTitleInput" KeyDown="OnLibraryTitleKeyDown" />
                                    <Button x:Name="LibraryRenameButton" Content="Save new title" Padding="14,7" Margin="8,0,0,0" Click="OnLibraryRenameClicked" />
                                </StackPanel>
                                <TextBlock x:Name="LibraryDetailBodyText" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <TextBlock x:Name="LibraryDetailApplicabilityText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FF6B7280" />
                                <TextBlock x:Name="LibraryDetailWarningsText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FF9A1C1C" />
                                <TextBlock Text="Use this item elsewhere (no ID to remember)" FontWeight="SemiBold" Margin="0,14,0,2" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <Button x:Name="LibraryUseAsRelationSubjectButton" Content="Link from this" Padding="14,7" Click="OnLibraryUseAsRelationSubjectClicked" />
                                    <Button x:Name="LibraryUseAsRelationObjectButton" Content="Link to this" Padding="14,7" Margin="8,0,0,0" Click="OnLibraryUseAsRelationObjectClicked" />
                                    <Button x:Name="LibraryUseInJobsButton" Content="Add to job inputs" Padding="14,7" Margin="8,0,0,0" Click="OnLibraryUseInJobsClicked" />
                                    <Button x:Name="LibraryUseInCatalogButton" Content="Publish this" Padding="14,7" Margin="8,0,0,0" Click="OnLibraryUseInCatalogClicked" />
                                </StackPanel>

                                <TextBlock Text="Stored citations (current / superseded / unknown are the service's answer)" FontWeight="SemiBold" Margin="0,14,0,6" />
                                <ListBox x:Name="LibraryCitations" Height="110" Background="#FFFDFDFD" BorderBrush="#FFD5D8DC"
                                         AutomationProperties.AutomationId="LibraryCitations" KeyDown="OnLibraryCitationKeyDown"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button x:Name="LibraryOpenSourceButton" Content="Open cited source at its revision" Padding="14,7"
                                        Margin="0,8,0,0" HorizontalAlignment="Left" Click="OnLibraryOpenSourceClicked" />

                                <TextBlock Text="Source as the service served it" FontWeight="SemiBold" Margin="0,14,0,0" />
                                <TextBlock x:Name="LibrarySourceText" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" />

                                <TextBlock Text="Decision history (recorded acts of this item)" FontWeight="SemiBold" Margin="0,14,0,0" />
                                <TextBlock x:Name="LibraryHistoryText" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="LibraryHistoryButton" Content="Read decision history" Padding="14,7"
                                        Margin="0,0,0,0" HorizontalAlignment="Left" Click="OnLibraryHistoryClicked" />
                                    <Button x:Name="LibraryRetainedButton" Content="Open retained revision" Padding="14,7"
                                        Margin="8,0,0,0" HorizontalAlignment="Left" Click="OnLibraryRetainedClicked" />
                                </StackPanel>
                                <TextBlock x:Name="LibraryRetainedText" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" />

                                <TextBlock Text="Recall policy (how this item is offered; never what it says)" FontWeight="SemiBold" Margin="0,14,0,0" />
                                <TextBlock x:Name="LibraryRecallText" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" />
                                <TextBox x:Name="LibraryRecallReasonInput" Width="360" Margin="0,8,0,0" VerticalContentAlignment="Center"
                                         AutomationProperties.AutomationId="LibraryRecallReasonInput" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="LibraryRecallReadButton" Content="Read recall state" Padding="14,7"
                                        HorizontalAlignment="Left" Click="OnLibraryRecallReadClicked" />
                                    <Button x:Name="LibraryRecallDemoteButton" Content="Demote priority" Padding="14,7"
                                        Margin="8,0,0,0" HorizontalAlignment="Left" Click="OnLibraryRecallDemoteClicked" />
                                    <Button x:Name="LibraryRecallPinButton" Content="Pin (protect)" Padding="14,7"
                                        Margin="8,0,0,0" HorizontalAlignment="Left" Click="OnLibraryRecallPinClicked" />
                                    <Button x:Name="LibraryRecallArchiveButton" Content="Set aside" Padding="14,7"
                                        Margin="8,0,0,0" HorizontalAlignment="Left" Click="OnLibraryRecallArchiveClicked" />
                                    <Button x:Name="LibraryRecallRestoreButton" Content="Restore" Padding="14,7"
                                        Margin="8,0,0,0" HorizontalAlignment="Left" Click="OnLibraryRecallRestoreClicked" />
                                </StackPanel>
                                <TextBlock Text="Owner purge (deletes exactly the previewed copies; originals outside the vault are untouched)" FontWeight="SemiBold" Margin="0,14,0,0" />
                                <TextBlock x:Name="LibraryPurgeText" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" />
                                <TextBox x:Name="LibraryPurgeReasonInput" Width="360" Margin="0,8,0,0" VerticalContentAlignment="Center"
                                         AutomationProperties.AutomationId="LibraryPurgeReasonInput" />
                                <TextBox x:Name="LibraryPurgeConfirmInput" Width="120" Margin="0,8,0,0" VerticalContentAlignment="Center"
                                         AutomationProperties.AutomationId="LibraryPurgeConfirmInput" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="LibraryPurgePreviewButton" Content="Preview purge" Padding="14,7"
                                        HorizontalAlignment="Left" Click="OnLibraryPurgePreviewClicked" />
                                    <Button x:Name="LibraryPurgeConfirmButton" Content="Confirm PURGE" Padding="14,7"
                                        Margin="8,0,0,0" HorizontalAlignment="Left" Click="OnLibraryPurgeConfirmClicked" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Next steps" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <Button x:Name="LibraryGoInboxButton" Content="Review proposals in Inbox" Padding="14,7" Click="OnGoInboxClicked" />
                            <Button x:Name="LibraryGoRelationsButton" Content="Link items in Relations" Padding="14,7" Margin="8,0,0,0" Click="OnGoRelationsClicked" />
                            <Button x:Name="LibraryGoSharingButton" Content="Share in Sharing" Padding="14,7" Margin="8,0,0,0" Click="OnGoSharingClicked" />
                        </StackPanel>

                        <TextBlock Text="Scope and limits of this view" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Collections and zones are selectors of your own vault: filtering by one narrows this search and grants nothing. Membership changes never widen a session, and a filter can never reach a resource your vault does not hold." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Searching reads the materialized library index generation, not the vault files: after a write (a new item, a revision, a publication change) the service refuses to search that generation and asks you to rebuild it, because a match it named could no longer be opened at that revision. A page is therefore only ever answered from a generation that still matches the vault." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• The body you see is the exact revision the service served. Decision history is the item's recorded lifecycle acts with the actor, time and rationale; a retained revision is the exact archived bytes of one older subject revision. History keeps original motivations; a contradiction is never resolved by newest-wins." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Current excludes withdrawn, rejected, expired and superseded items; choose History to keep them. As-of replays recorded history only through that instant. A citation the service reports as unknown or superseded is shown as such, with its warning; a missing source stays visibly missing and is never presented as verified." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Keyboard: Ctrl+F focuses the search box, Enter searches, arrows choose a result, Enter opens it, Enter on a citation opens that source, and Ctrl+L locks the vault." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Privacy: this view holds no on-disk cache. Locking the vault (or losing the service) clears the page, the open item, the open source and your search text, and an answer already in flight is discarded instead of restoring them." />
                    </StackPanel>

                    <StackPanel x:Name="InboxPanel" Visibility="Collapsed">
                        <TextBlock Text="Inbox" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Capture unstructured text into your encrypted vault and review the proposals agents left for you. The service owns the encrypted source write, the proposal inbox, the reviewed item, its publication decision and that decision's history; this console only sends your acts and renders the answers it receives. Neither act needs a provider, a network call or a fetch." />

                        <TextBlock Text="Capture a note (text and zone are the write; metadata is optional)" FontWeight="SemiBold" Margin="0,18,0,0" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF6B7280"
                                   Text="The text is stored as an encrypted registered source before any structuring step runs, so a note survives a restart and a provider failure. A URL is only a locator: it is never fetched and never treated as a paper you have read. Clearing this editor writes nothing; locking clears it, which is why lock asks first." />
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF6B7280"
                                   Text="A zone is a permission boundary: pick the boundary this note belongs to, or type a new one. The service stores the note encrypted under exactly that zone." />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Note ID (you name it)" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="CaptureResourceInput" Margin="0,0,10,6"
                                     AutomationProperties.AutomationId="CaptureResourceInput" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Zone" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <ComboBox Grid.Row="0" Grid.Column="3" x:Name="CaptureZoneInput" Margin="0,0,0,6"
                                      IsEditable="True" AutomationProperties.AutomationId="CaptureZoneInput" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Title (optional)" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="CaptureTitleInput" Margin="0,0,10,6"
                                     AutomationProperties.AutomationId="CaptureTitleInput" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Locator / URL" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="CaptureLocatorInput" Margin="0,0,0,6"
                                     AutomationProperties.AutomationId="CaptureLocatorInput" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Source speaker (optional)" Foreground="#FF6B7280" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="CaptureAuthorInput" Margin="0,0,10,0"
                                     AutomationProperties.AutomationId="CaptureAuthorInput" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Source date (UTC)" Foreground="#FF6B7280" />
                            <TextBox Grid.Row="2" Grid.Column="3" x:Name="CaptureDateInput"
                                     AutomationProperties.AutomationId="CaptureDateInput" />
                        </Grid>

                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF6B7280"
                                   Text="Speaker accepts user, assistant, tool or external and may stay empty: an omitted speaker stays unknown and is never inferred from the text or the URL. The date accepts yyyy-MM-dd and may stay empty." />

                        <TextBox x:Name="CaptureTextInput" Height="130" Margin="0,10,0,0" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                 AutomationProperties.AutomationId="CaptureTextInput" TextChanged="OnCaptureTextChanged" />
                        <TextBlock x:Name="CaptureHintText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF6B7280" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="CaptureSaveButton" Content="Save capture" Padding="14,7" Click="OnCaptureSaveClicked" />
                            <Button x:Name="CaptureClearButton" Content="Clear editor" Padding="14,7" Margin="8,0,0,0" Click="OnCaptureClearClicked" />
                        </StackPanel>

                        <TextBlock x:Name="CaptureMessageText" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold" />
                        <TextBlock x:Name="CaptureSavedText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF6B7280" />

                        <TextBlock Text="Read a captured note back from the vault" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF6B7280"
                                   Text="This is the same read that shows a saved note again after the service restarted: the exact characters the vault holds, never a reconstruction, and with no provider involved." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox x:Name="CaptureReadBackIdInput" Width="260" VerticalContentAlignment="Center"
                                     AutomationProperties.AutomationId="CaptureReadBackIdInput" />
                            <TextBlock Text="revision" Foreground="#FF6B7280" VerticalAlignment="Center" Margin="10,0,6,0" />
                            <TextBox x:Name="CaptureReadBackRevisionInput" Width="70" VerticalContentAlignment="Center"
                                     AutomationProperties.AutomationId="CaptureReadBackRevisionInput" />
                            <Button x:Name="CaptureReadBackButton" Content="Read it back" Padding="14,7" Margin="10,0,0,0" Click="OnCaptureReadBackClicked" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF6B7280"
                                   Text="Tip: after saving above, choose “Use saved capture” to fill this in — no ID to remember. A revision stays empty for the live revision." />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="CaptureReadBackUseSavedButton" Content="Use saved capture" Padding="14,7" Click="OnCaptureReadBackUseSavedClicked" />
                        </StackPanel>
                        <TextBlock x:Name="CaptureReadBackMessageText" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock x:Name="CaptureReadBackSourceText" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" />
                        <TextBox x:Name="CaptureReadBackText" Height="130" Margin="0,6,0,0" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                 AutomationProperties.AutomationId="CaptureReadBackText" />

                        <TextBlock Text="Proposals waiting for your review" FontWeight="SemiBold" Margin="0,22,0,0" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF6B7280"
                                   Text="A proposal is a pending write an agent asked for. It is not a memory item and it changed nothing; it stays pending until you publish or reject it. Publishing writes the content you reviewed into your vault and records your publication decision; rejecting records your decision without applying the proposal." />

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="ReviewInboxButton" Content="Refresh proposal inbox" Padding="14,7" Click="OnReviewInboxClicked" />
                            <Button x:Name="ReviewOpenButton" Content="Open selected proposal" Padding="14,7" Margin="8,0,0,0" Click="OnReviewOpenClicked" />
                        </StackPanel>
                        <TextBlock x:Name="ReviewInboxMessageText" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <ListBox x:Name="ReviewProposals" Height="110" Margin="0,8,0,0" Background="White" BorderBrush="#FFD5D8DC"
                                 AutomationProperties.AutomationId="ReviewProposals"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnReviewProposalSelectionChanged" KeyDown="OnReviewProposalKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border x:Name="ReviewPanel" Margin="0,14,0,0" Padding="14" Background="White"
                                BorderBrush="#FFD5D8DC" BorderThickness="1" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="Review — the cited source beside the content" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock x:Name="ReviewProvenanceText" TextWrapping="Wrap" Margin="0,8,0,0" FontFamily="Consolas" />
                                <TextBlock x:Name="ReviewItemStateText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF6B7280" />
                                <TextBlock x:Name="ReviewStalenessText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF9A3412"
                                           AutomationProperties.AutomationId="ReviewStalenessText" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Cited evidence as the service served it" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ReviewSourceMetaText" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" />
                                        <TextBlock x:Name="ReviewSourceMessageText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF6B7280" />
                                        <TextBox x:Name="ReviewSourceText" Height="200" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True"
                                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                                 AutomationProperties.AutomationId="ReviewSourceText" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Reviewed content (the editor)" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ReviewAttributionText" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF6B7280"
                                                   Text="Author, creation method and evidence level belong to the record: editing the content never rewrites them, and the service refuses a review that tries." />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="Kind" Foreground="#FF6B7280" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox x:Name="ReviewKindInput" Width="150" AutomationProperties.AutomationId="ReviewKindInput" />
                                            <TextBlock Text="Level" Foreground="#FF6B7280" VerticalAlignment="Center" Margin="12,0,6,0" />
                                            <ComboBox x:Name="ReviewLevelInput" Width="110" AutomationProperties.AutomationId="ReviewLevelInput" />
                                        </StackPanel>
                                        <TextBlock Text="Title" Foreground="#FF6B7280" Margin="0,8,0,2" />
                                        <TextBox x:Name="ReviewTitleInput" AutomationProperties.AutomationId="ReviewTitleInput" />
                                        <TextBlock Text="Body" Foreground="#FF6B7280" Margin="0,8,0,2" />
                                        <TextBox x:Name="ReviewBodyInput" Height="170" AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                                 AutomationProperties.AutomationId="ReviewBodyInput" />
                                        <TextBlock x:Name="ReviewCitationsText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FF6B7280" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Rationale (required to reject or to undo; the service records it in the item's history)" Margin="0,14,0,2" Foreground="#FF6B7280" />
                                <TextBox x:Name="ReviewRationaleInput" AcceptsReturn="True" Height="54" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ReviewRationaleInput" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="ReviewPublishButton" Content="Publish reviewed content" Padding="14,7" Click="OnReviewPublishClicked" />
                                    <Button x:Name="ReviewRejectButton" Content="Reject proposal" Padding="14,7" Margin="8,0,0,0" Click="OnReviewRejectClicked" />
                                    <Button x:Name="ReviewUndoButton" Content="Undo decision" Padding="14,7" Margin="8,0,0,0" Click="OnReviewUndoClicked" />
                                </StackPanel>

                                <TextBlock x:Name="ReviewMessageText" TextWrapping="Wrap" Margin="0,12,0,0" FontWeight="SemiBold" />
                                <Border Margin="0,14,0,0" Padding="14" Background="#FFF7F9FC" BorderBrush="#FFD5D8DC" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Declassify — publish a sanitized copy into an explicit shared zone" FontWeight="SemiBold" FontSize="14" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="Shared item ID" Foreground="#FF6B7280" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox x:Name="DeclassifyDestinationInput" Width="220" AutomationProperties.AutomationId="DeclassifyDestinationInput" />
                                            <TextBlock Text="Shared zone" Foreground="#FF6B7280" VerticalAlignment="Center" Margin="12,0,6,0" />
                                            <ComboBox x:Name="DeclassifyZoneInput" Width="200" IsEditable="True" AutomationProperties.AutomationId="DeclassifyZoneInput" />
                                            <Button x:Name="DeclassifyPreviewButton" Content="Preview sanitized publication" Padding="14,7" Margin="12,0,0,0" Click="OnDeclassifyPreviewClicked" />
                                        </StackPanel>
                                        <TextBlock x:Name="DeclassifyPreviewText" TextWrapping="Wrap" Margin="0,8,0,0" FontFamily="Consolas" AutomationProperties.AutomationId="DeclassifyPreviewText" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF6B7280"
                                                   Text="A shared zone is a boundary agents may already read: pick one you already use, or type a new one. The copy carries no citations." />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="Type PUBLISH to approve" Foreground="#FF6B7280" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox x:Name="DeclassifyConfirmInput" Width="120" AutomationProperties.AutomationId="DeclassifyConfirmInput" />
                                            <Button x:Name="DeclassifyPublishButton" Content="Publish sanitized copy" Padding="14,7" Margin="12,0,0,0" Click="OnDeclassifyPublishClicked" />
                                        </StackPanel>
                                        <TextBlock x:Name="DeclassifyMessageText" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" AutomationProperties.AutomationId="DeclassifyMessageText" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Border>

                        <TextBlock Text="Next steps" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <Button x:Name="InboxGoLibraryButton" Content="Find it in Library" Padding="14,7" Click="OnGoLibraryClicked" />
                            <Button x:Name="InboxGoSharingButton" Content="Share in Sharing" Padding="14,7" Margin="8,0,0,0" Click="OnGoSharingClicked" />
                            <Button x:Name="InboxGoJobsButton" Content="Structure in Jobs" Padding="14,7" Margin="8,0,0,0" Click="OnGoJobsClicked" />
                        </StackPanel>
                        <TextBlock Text="Scope and limits of this view" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• A proposal record is never edited by this console or by any agent act: it stays the pending record the agent wrote, with its executor, its idempotency identity and its content hash, so what you reviewed is retrievable later." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Publishing writes the content you reviewed through the same revision-gated write path a direct owner write uses, and records your decision as the item's publication state. A proposal that moved, or content that names a different author, creation method or evidence level, is refused — approving an AI-written note never makes it user-written or user-confirmed." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Rejecting records your decision on the reviewed item without applying the proposal: a revise proposal leaves the item it would have revised at its own revision, content and publication state. The rejected content stays encrypted, is not current in a search, and can be proposed again instead of being written twice." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Undo keeps the same canonical record: a published review item is withdrawn and a rejected one returns to proposal, with your rationale in its history, its content, author, creation method and evidence unchanged. No copy of the item is written and no AI-written text is relabelled." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• A revision a published proposal applied to an existing item is not undone here: restoring a superseded revision needs the lifecycle-retained archive read, which lands in a later sprint. This console says so instead of pretending." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• No provider, network call or URL fetch happens on this screen, and no plaintext draft is written to disk: the editor text lives in this process until you save it, clear it, or lock the vault." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Keyboard: Ctrl+F focuses the search box of Library, Ctrl+L locks the vault (and asks first when the capture editor still holds unsaved text)." />
                    </StackPanel>

                    <StackPanel x:Name="RelationsPanel" Visibility="Collapsed">
                        <TextBlock Text="Relations" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Every typed link below is a record of your vault: the service mints its identity, verifies both endpoints at the exact revisions the link pins, decides the derivation graph and computes whether the link can still be trusted. This console sends your draft and renders the answer; it keeps no link store, no visibility policy of its own and no file. A related_to association and an evidence-bearing supports link stay different records, and only your explicit act turns an agent's proposal into a confirmed link." />

                        <TextBlock Text="Service reports" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock x:Name="RelationsStateText" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="16" />
                        <TextBlock x:Name="RelationsMessageText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FF6B7280" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="RelationsRefreshButton" Content="Read relation set" Padding="14,7" Click="OnRelationsRefreshClicked" />
                            <Button x:Name="RelationsInspectButton" Content="Inspect selected relation" Padding="14,7" Margin="8,0,0,0" Click="OnRelationsInspectClicked" />
                            <TextBlock Text="Show" Foreground="#FF6B7280" VerticalAlignment="Center" Margin="16,0,6,0" />
                            <ComboBox x:Name="RelationsFilterInput" Width="170" AutomationProperties.AutomationId="RelationsFilterInput"
                                      SelectionChanged="OnRelationsFilterChanged" />
                        </StackPanel>

                        <ListBox x:Name="RelationsList" Height="170" Margin="0,8,0,0" Background="White" BorderBrush="#FFD5D8DC"
                                 AutomationProperties.AutomationId="RelationsList"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnRelationsSelectionChanged" KeyDown="OnRelationsListKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border x:Name="RelationDetailPanel" Margin="0,14,0,0" Padding="14" Background="White"
                                BorderBrush="#FFD5D8DC" BorderThickness="1" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="Open relation (the exact revision the service served)" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock x:Name="RelationProvenanceText" TextWrapping="Wrap" Margin="0,8,0,0" FontFamily="Consolas" />
                                <TextBlock x:Name="RelationEndpointsText" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" />
                                <TextBlock x:Name="RelationConfirmationText" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock x:Name="RelationEvidenceText" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" />
                                <TextBlock x:Name="RelationReviewText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FF9A1C1C" />

                                <TextBlock Text="Rationale (the shared core requires one to reject or to remove a link; a relink carries none)" Foreground="#FF6B7280" Margin="0,12,0,2" />
                                <TextBox x:Name="RelationRationaleInput" AcceptsReturn="True" Height="48" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="RelationRationaleInput" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="RelationConfirmButton" Content="Confirm link (owner)" Padding="14,7" Click="OnRelationConfirmClicked" />
                                    <Button x:Name="RelationRejectButton" Content="Reject link" Padding="14,7" Margin="8,0,0,0" Click="OnRelationRejectClicked" />
                                    <Button x:Name="RelationRemoveButton" Content="Remove link" Padding="14,7" Margin="8,0,0,0" Click="OnRelationRemoveClicked" />
                                    <Button x:Name="RelationUndoButton" Content="Undo removal" Padding="14,7" Margin="8,0,0,0" Click="OnRelationUndoClicked" />
                                </StackPanel>

                                <TextBlock x:Name="RelationMessageText" TextWrapping="Wrap" Margin="0,12,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Create a link between two endpoints you pick" FontWeight="SemiBold" Margin="0,20,0,0" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF6B7280"
                                   Text="Memory items come from the service's own library search below (rebuild the library index first); a registered source comes from the picker further below. Nothing here decides the kind for you: related_to is an association, supports asserts that one endpoint is evidence for the other, and the service refuses a derivation cycle while allowing related_to to repeat." />

                        <TextBlock Text="Find memory items in the library index" FontWeight="SemiBold" Margin="0,12,0,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBox x:Name="RelationCandidateQueryInput" Width="260" VerticalContentAlignment="Center"
                                     AutomationProperties.AutomationId="RelationCandidateQueryInput" KeyDown="OnRelationCandidateQueryKeyDown" />
                            <Button x:Name="RelationCandidateSearchButton" Content="Find endpoints in library" Padding="14,7" Margin="10,0,0,0" Click="OnRelationCandidateSearchClicked" />
                        </StackPanel>
                        <TextBlock x:Name="RelationCandidateMessageText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FF6B7280" />
                        <ListBox x:Name="RelationCandidates" Height="110" Margin="0,8,0,0" Background="White" BorderBrush="#FFD5D8DC"
                                 AutomationProperties.AutomationId="RelationCandidates"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnRelationCandidateSelectionChanged" KeyDown="OnRelationCandidateKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="RelationSetSubjectButton" Content="Use selected as subject" Padding="14,7" Click="OnRelationSetSubjectClicked" />
                            <Button x:Name="RelationSetObjectButton" Content="Use selected as object" Padding="14,7" Margin="8,0,0,0" Click="OnRelationSetObjectClicked" />
                            <Button x:Name="RelationUseLibrarySubjectButton" Content="Use open library item as subject" Padding="14,7" Margin="8,0,0,0" Click="OnRelationUseLibrarySubjectClicked" />
                            <Button x:Name="RelationUseLibraryObjectButton" Content="Use open library item as object" Padding="14,7" Margin="8,0,0,0" Click="OnRelationUseLibraryObjectClicked" />
                        </StackPanel>

                        <TextBlock Text="Registered source endpoint (from the Sources you already read)" FontWeight="SemiBold" Margin="0,12,0,2" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Foreground="#FF6B7280"
                                   Text="Pick an enrolled source below — its live registry revision travels, no ID to retype. Sources appear here after you read them in Sources." />
                        <ComboBox x:Name="RelationSourcePickerInput" Margin="0,0,0,6"
                                  AutomationProperties.AutomationId="RelationSourcePickerInput" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="RelationUseSourceSubjectButton" Content="Use source as subject" Padding="14,7" Margin="0,0,0,0" Click="OnRelationUsePickedSourceSubjectClicked" />
                            <Button x:Name="RelationUseSourceObjectButton" Content="Use source as object" Padding="14,7" Margin="8,0,0,0" Click="OnRelationUsePickedSourceObjectClicked" />
                        </StackPanel>

                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF6B7280"
                                   Text="A source outside the picker above stays out of reach: read it in Sources first so its live revision is known." />

                        <TextBlock x:Name="RelationSubjectText" TextWrapping="Wrap" Margin="0,10,0,0" FontFamily="Consolas" />
                        <TextBlock x:Name="RelationObjectText" TextWrapping="Wrap" Margin="0,4,0,0" FontFamily="Consolas" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Relation ID (you name it)" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="RelationIdInput" Margin="0,0,10,6"
                                     AutomationProperties.AutomationId="RelationIdInput" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Zone" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <ComboBox Grid.Row="0" Grid.Column="3" x:Name="RelationZoneInput" Margin="0,0,0,6"
                                      IsEditable="True" AutomationProperties.AutomationId="RelationZoneInput" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Kind" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="RelationKindInput" Margin="0,0,10,6"
                                      AutomationProperties.AutomationId="RelationKindInput" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Record as" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <ComboBox Grid.Row="1" Grid.Column="3" x:Name="RelationStateInput" Margin="0,0,0,6"
                                      AutomationProperties.AutomationId="RelationStateInput" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Reason" Foreground="#FF6B7280" />
                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="RelationReasonInput"
                                     AutomationProperties.AutomationId="RelationReasonInput" />
                        </Grid>
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF6B7280"
                                   Text="“accepted” records the link as your own conclusion, “proposed” leaves it for your later confirmation. The service stores the choice with its executor and time; a link an agent proposed can be confirmed here and keeps the agent's words as a claim." />

                        <Button x:Name="RelationCreateButton" Content="Create link" Padding="14,7"
                                Margin="0,10,0,0" HorizontalAlignment="Left" Click="OnRelationCreateClicked" />

                        <TextBlock Text="Next steps" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <Button x:Name="RelationsGoLibraryButton" Content="Find endpoints in Library" Padding="14,7" Click="OnGoLibraryClicked" />
                            <Button x:Name="RelationsGoSourcesButton" Content="Tend sources in Sources" Padding="14,7" Margin="8,0,0,0" Click="OnGoSourcesClicked" />
                        </StackPanel>
                        <TextBlock Text="Scope and limits of this view" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• The relation set shown here is your own vault seen as its owner: the service filters nothing from you. A link an agent wrote is the same canonical record, with its own executor, its reported words and its proposed state, and it is never presented as your confirmation." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• An endpoint the link pinned at a revision that has since changed, a missing endpoint, an unavailable cited source or a changed dependency appear as the service's own review state with the reasons it evaluated — this console never re-evaluates the link or repairs it silently." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Removing a link retracts it (with your rationale) instead of deleting it; undo returns it to proposed, never straight to accepted, because re-asserting an acceptance is your explicit act." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Nothing on this screen fetches a source, calls a provider, writes a vault file or stores a link of its own: every act is one request to the running service, and what an agent session can see is decided by that session's grant, not here." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Keyboard: Enter in the relation list inspects the selected link, Enter in the candidate list picks it as the subject, F5 in this view reads the relation set again, Ctrl+L locks the vault." />
                    </StackPanel>

                    <StackPanel x:Name="SharingPanel" Visibility="Collapsed">
                        <TextBlock Text="Sharing" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Publish what agents may discover, review what they asked for, and see what their sessions can still read. The service owns the encrypted catalog mapping, the pending requests, the bound previews, the issued grants and the live sessions; this console only sends your explicit acts and renders the answers it receives. A pending request is never permission: only your approval below mints a grant, and the bearer travels only into a DPAPI-protected local handoff file whose path — never the token — is shown." />

                        <TextBlock Text="Service reports" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock x:Name="SharingStateText" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="16" />

                        <TextBlock Text="Catalog publication (only the label and description you type become public)" FontWeight="SemiBold" Margin="0,18,0,0" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF6B7280"
                                   Text="A publication preview mutates nothing and mints no access. The label and description are explicit owner text: this screen never fills them from a private title, path or citation, and neither does the service. Publishing stores exactly what the preview showed; withdrawing removes the entry from future discovery (copies already delivered cannot be recalled)." />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Catalog ID (you name it)" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="CatalogIdInput" Margin="0,0,10,6"
                                     AutomationProperties.AutomationId="CatalogIdInput" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Mapped resource ID" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="CatalogResourceInput" Margin="0,0,0,6"
                                     AutomationProperties.AutomationId="CatalogResourceInput" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Public label" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="CatalogLabelInput" Margin="0,0,10,6"
                                     AutomationProperties.AutomationId="CatalogLabelInput" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Public description" Foreground="#FF6B7280" Margin="0,0,0,6" />
                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="CatalogDescriptionInput" Margin="0,0,0,6"
                                     AutomationProperties.AutomationId="CatalogDescriptionInput" />
                        </Grid>
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF6B7280"
                                   Text="The mapped resource is the private item this entry points at. Pick it from what the service already showed you — no ID to memorize." />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="CatalogUseLibraryButton" Content="Use open library item" Padding="14,7" Click="OnCatalogUseLibraryClicked" />
                            <Button x:Name="CatalogUseCaptureButton" Content="Use saved capture" Padding="14,7" Margin="8,0,0,0" Click="OnCatalogUseCaptureClicked" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="CatalogPreviewButton" Content="Preview publication" Padding="14,7" Click="OnCatalogPreviewClicked" />
                            <Button x:Name="CatalogPublishButton" Content="Publish this exact metadata" Padding="14,7" Margin="8,0,0,0" Click="OnCatalogPublishClicked" />
                            <Button x:Name="CatalogRefreshButton" Content="Read catalog mappings" Padding="14,7" Margin="8,0,0,0" Click="OnCatalogRefreshClicked" />
                        </StackPanel>
                        <TextBlock x:Name="CatalogPreviewText" TextWrapping="Wrap" Margin="0,10,0,0" FontFamily="Consolas" />
                        <TextBlock x:Name="CatalogMessageText" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" />
                        <ListBox x:Name="CatalogList" Height="120" Margin="0,8,0,0" Background="White" BorderBrush="#FFD5D8DC"
                                 AutomationProperties.AutomationId="CatalogList"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnCatalogSelectionChanged" KeyDown="OnCatalogListKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="CatalogWithdrawButton" Content="Withdraw selected entry" Padding="14,7" Click="OnCatalogWithdrawClicked" />
                        </StackPanel>

                        <TextBlock Text="Access requests (purpose first — a request is never permission)" FontWeight="SemiBold" Margin="0,22,0,0" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF6B7280"
                                   Text="Read the pending requests, bind one to its frozen snapshot to see the exact resources, revisions, bodies and disclosure it asks about, then narrow it to a smaller scope, approve exactly that scope, or reject it. Approving mints only a narrowed subset of the previewed IDs and operations — never more — and writes the bearer only into the DPAPI-protected local handoff file you name." />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="RequestsRefreshButton" Content="Read access requests" Padding="14,7" Click="OnRequestsRefreshClicked" />
                            <Button x:Name="RequestPreviewButton" Content="Preview selected request" Padding="14,7" Margin="8,0,0,0" Click="OnRequestPreviewClicked" />
                        </StackPanel>
                        <TextBlock x:Name="RequestsMessageText" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold" />
                        <ListBox x:Name="RequestsList" Height="120" Margin="0,8,0,0" Background="White" BorderBrush="#FFD5D8DC"
                                 AutomationProperties.AutomationId="RequestsList"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnRequestsSelectionChanged" KeyDown="OnRequestsListKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border x:Name="RequestDetailPanel" Margin="0,14,0,0" Padding="14" Background="White"
                                BorderBrush="#FFD5D8DC" BorderThickness="1" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="Bound request preview (the exact snapshot an approval would draw from)" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock x:Name="RequestPreviewSummaryText" TextWrapping="Wrap" Margin="0,8,0,0" FontFamily="Consolas" />
                                <TextBox x:Name="RequestPreviewBodiesText" Height="150" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                         AutomationProperties.AutomationId="RequestPreviewBodiesText" />
                                <TextBlock Text="Narrow this preview (subsets only — the service refuses any growth)" Foreground="#FF6B7280" Margin="0,12,0,2" />
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Foreground="#FF6B7280"
                                           Text="Tick only what this approval should cover. Unticked resources and operations stay out of the grant; leaving every box ticked approves the whole bound snapshot. The lists below are the exact snapshot you previewed — nothing outside them can be approved." />
                                <TextBlock Text="Resources in this approval" FontWeight="SemiBold" Margin="0,8,0,2" />
                                <ListBox x:Name="ApproveResourceList" MinHeight="60" MaxHeight="130" Margin="0,0,0,0" Background="White" BorderBrush="#FFD5D8DC"
                                         AutomationProperties.AutomationId="ApproveResourceList"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionMode="Multiple" SelectionChanged="OnApproveSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="Operations in this approval" FontWeight="SemiBold" Margin="0,8,0,2" />
                                <ListBox x:Name="ApproveOperationList" MinHeight="44" MaxHeight="110" Margin="0,0,0,0" Background="White" BorderBrush="#FFD5D8DC"
                                         AutomationProperties.AutomationId="ApproveOperationList"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionMode="Multiple" SelectionChanged="OnApproveSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="ApproveOperationsHelpText" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF6B7280"
                                           Text="Leave every operation unticked for read-only (resource.read)." />
                                <TextBlock Text="Write destinations (only when the ticked operations need one)" FontWeight="SemiBold" Margin="0,8,0,2" />
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Foreground="#FF6B7280"
                                           Text="proposal.create, link.create and link.supersede need a destination inbox you name. Leave empty otherwise." />
                                <TextBox x:Name="ApproveDestinationIdsInput" Margin="0,0,0,6"
                                         AutomationProperties.AutomationId="ApproveDestinationIdsInput" />
                                <TextBlock Text="Access ends at (expiry, UTC)" FontWeight="SemiBold" Margin="0,8,0,2" />
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="ApproveExpiryPresetInput" Margin="0,0,10,6"
                                              AutomationProperties.AutomationId="ApproveExpiryPresetInput"
                                              SelectionChanged="OnApproveExpiryPresetChanged" />
                                    <TextBox Grid.Column="1" x:Name="ApproveExpiryInput" Margin="0,0,0,6"
                                             AutomationProperties.AutomationId="ApproveExpiryInput" />
                                </Grid>
                                <TextBlock x:Name="ApproveExpiryHelpText" TextWrapping="Wrap" Margin="0,0,0,2" Foreground="#FF6B7280"
                                           Text="The expiry must be a future UTC instant (ISO 8601 with a Z suffix). After it passes, the session authorizes nothing." />
                                <TextBlock Text="Provider egress (only with the provider.egress operation)" FontWeight="SemiBold" Margin="0,8,0,2" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBox x:Name="ApproveProviderInput" Width="150" VerticalContentAlignment="Center"
                                             AutomationProperties.AutomationId="ApproveProviderInput" />
                                    <TextBox x:Name="ApproveModelInput" Width="150" VerticalContentAlignment="Center" Margin="8,0,0,0"
                                             AutomationProperties.AutomationId="ApproveModelInput" />
                                    <TextBox x:Name="ApproveMaxCostInput" Width="90" VerticalContentAlignment="Center" Margin="8,0,0,0"
                                             AutomationProperties.AutomationId="ApproveMaxCostInput" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Foreground="#FF6B7280"
                                           Text="Provider, model and cost limit travel together and must match the request's declared disclosure. The cost limit is at most $0.25 per job." />
                                <TextBlock Text="Local handoff file (where the token is written)" FontWeight="SemiBold" Margin="0,8,0,2" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBox x:Name="ApproveHandoffInput" Width="380" VerticalContentAlignment="Center"
                                             AutomationProperties.AutomationId="ApproveHandoffInput" />
                                    <Button x:Name="ApproveHandoffBrowseButton" Content="Choose file…" Padding="14,7" Margin="8,0,0,0" Click="OnApproveHandoffBrowseClicked" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Foreground="#FF6B7280"
                                           Text="Choose a new file inside a folder that already exists. The bearer is sealed for this Windows account into that file only; this console shows the path, never the token." />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="RequestApproveButton" Content="Approve this narrowed scope" Padding="14,7" Click="OnRequestApproveClicked" />
                                    <Button x:Name="RequestRejectButton" Content="Reject request" Padding="14,7" Margin="8,0,0,0" Click="OnRequestRejectClicked" />
                                </StackPanel>
                                <TextBlock x:Name="RequestDecisionText" TextWrapping="Wrap" Margin="0,12,0,0" FontWeight="SemiBold" />
                                <TextBlock x:Name="RequestHandoffText" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Live sessions (effective frozen scope — what each session can still read)" FontWeight="SemiBold" Margin="0,22,0,0" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF6B7280"
                                   Text="Each row is the session's frozen grant snapshot: concrete IDs/revisions, operations, expiry and egress. Added members or revisions never enter a frozen scope afterwards. Revoking ends that session's bearer immediately; locking the vault ends every session." />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="SessionsRefreshButton" Content="Read live sessions" Padding="14,7" Click="OnSessionsRefreshClicked" />
                            <Button x:Name="SessionRevokeButton" Content="Revoke selected session" Padding="14,7" Margin="8,0,0,0" Click="OnSessionRevokeClicked" />
                        </StackPanel>
                        <TextBlock x:Name="SessionsMessageText" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold" />
                        <ListBox x:Name="SessionsList" Height="120" Margin="0,8,0,0" Background="White" BorderBrush="#FFD5D8DC"
                                 AutomationProperties.AutomationId="SessionsList"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnSessionsSelectionChanged" KeyDown="OnSessionsListKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="SessionDetailText" TextWrapping="Wrap" Margin="0,8,0,0" FontFamily="Consolas" />

                        <TextBlock Text="Next steps" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <Button x:Name="SharingGoLibraryButton" Content="Find items in Library" Padding="14,7" Click="OnGoLibraryClicked" />
                            <Button x:Name="SharingGoInboxButton" Content="Review proposals in Inbox" Padding="14,7" Margin="8,0,0,0" Click="OnGoInboxClicked" />
                        </StackPanel>
                        <TextBlock Text="Scope and limits of this view" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• The private index is not the catalog: discovery serves only the ID/label/description triplets you published, and searching or reading a body needs a redeemed session inside its own grant — never this screen." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• A publication preview shows exactly what would be stored and mints nothing; cancelled previews change no discovery. A stale bound preview (a changed revision, membership or mapping) fails an approval closed, and an already-used token never redeems twice." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Added members, revisions or links never widen a frozen grant or session: narrowing below the bound preview is the only direction this screen offers, and the service refuses any growth." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• The token handoff is a DPAPI-protected local file owned by this Windows account (owner/SYSTEM/Administrators only). This console shows its path, never the token; no key or token travels through chat, logs, arguments or screenshots." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• No protected launcher or alternate key/policy store exists on this path: every act above is one request to the running service over the owner control pipe, under the shared core policy." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="• Keyboard: Enter in a list opens the selected row, F5 in this view re-reads the catalog, requests and sessions, Ctrl+L locks the vault." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
