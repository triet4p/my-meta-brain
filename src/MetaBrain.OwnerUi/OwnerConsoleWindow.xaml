                        <TextBlock Text="Service reports" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock x:Name="SourcesStateText" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="16" />

                        <TextBlock Text="Enrolled sources (allowlist — listing opens no transcript)" FontWeight="SemiBold" Margin="0,18,0,0" />
