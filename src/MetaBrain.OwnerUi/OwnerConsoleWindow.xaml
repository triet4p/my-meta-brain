                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Format version" Foreground="#FF6B7280" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="MappingFormatVersionInput" Margin="0,0,10,0"
                                     AutomationProperties.AutomationId="MappingFormatVersionInput" />
                        </Grid>
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF6B7280"
                                   Text="Leave the zone empty when it is unresolved, and the format empty when it is unresolved. The held detail names which field is unresolved; nothing is defaulted." />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
