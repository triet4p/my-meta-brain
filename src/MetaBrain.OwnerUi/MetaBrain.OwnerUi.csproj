<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MetaBrain.OwnerUi</AssemblyName>
    <RootNamespace>MetaBrain.OwnerUi</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Frozen 1.1.0 legacy product (CR03/D089). The 1.2.0 release ships the
         CLI and MCP only, so this source is kept for history and transition
         proof and is never packaged. It keeps its own version so any local
         build identifies itself as the 1.1.0 WPF product, not as a 1.2 one. -->
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- The owner application reaches the shared core/application policy only
         through the owner control channel client in Connections; it has no
         reference to the vault store and applies no policy of its own. -->
    <ProjectReference Include="..\MetaBrain.Connections\MetaBrain.Connections.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The repository's permanent regression suite drives the console session
         (the exact class the window uses) in process, so the private-state lock
         boundary is verified deterministically. It is a friend assembly only;
         nothing here is a product surface. -->
    <InternalsVisibleTo Include="MetaBrain.S1T4.Smoke" />
  </ItemGroup>
</Project>
