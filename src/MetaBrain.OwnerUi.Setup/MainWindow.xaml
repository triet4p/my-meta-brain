<Window x:Class="MetaBrain.OwnerUi.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meta Brain Owner UI Setup" Width="620" Height="640"
        MinWidth="580" MinHeight="420" WindowStartupLocation="Manual"
        Background="#F5F7FA" Foreground="#17212B" FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" Margin="8,8,8,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Meta Brain" FontSize="28" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Grid.Row="1" Margin="0,2,0,14" Text="Owner UI setup" FontSize="15" Foreground="#526171" />
                <Border Grid.Row="2" Padding="10" CornerRadius="6" Background="#FFF4D6" BorderBrush="#D6A23A" BorderThickness="1">
                    <TextBlock FontSize="12" TextWrapping="Wrap">Unsigned setup. SHA-256 checks file integrity, not publisher identity. Setup temporarily extracts its embedded release payload under the current user's TEMP folder while installing, then removes that staging folder when possible. The self-contained host may also cache files under %TEMP%\.net. Setup does not change PATH, profiles, environment settings, services, registry, permissions, or autostart.</TextBlock>
                </Border>
                <StackPanel Grid.Row="3" Margin="0,14,0,8">
                    <TextBlock Text="Application location" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <DockPanel>
                        <Button x:Name="BrowseInstallButton" DockPanel.Dock="Right" Content="Browse…" Width="94" Margin="8,0,0,0" Click="BrowseInstall_Click" />
                        <TextBox x:Name="InstallRootBox" Height="34" Padding="8,6" VerticalContentAlignment="Center" AutomationProperties.Name="Application install location" TextChanged="InstallRoot_TextChanged" />
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Row="4" Margin="0,4,0,8">
                    <TextBlock Text="Owner data location (kept separate from application files)" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <DockPanel>
                        <Button x:Name="BrowseDataButton" DockPanel.Dock="Right" Content="Browse…" Width="94" Margin="8,0,0,0" Click="BrowseData_Click" />
                        <TextBox x:Name="DataRootBox" Height="34" Padding="8,6" VerticalContentAlignment="Center" AutomationProperties.Name="Owner data location" />
                    </DockPanel>
                </StackPanel>
                <CheckBox x:Name="LaunchAfterInstallBox" Grid.Row="5" Margin="0,8,0,8" IsChecked="True" Content="Open the Owner UI when setup finishes" />
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="8,0,8,8">
            <Border Padding="10" CornerRadius="5" Background="White" BorderBrush="#D7DEE7" BorderThickness="1" Margin="0,0,0,8">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="SetupStatus" Text="Choose application and data locations. Existing registered data location is retained." />
            </Border>
            <DockPanel LastChildFill="False">
                <Button x:Name="UninstallButton" DockPanel.Dock="Left" Content="Remove Owner UI…" MinWidth="140" Height="38" Margin="0,0,8,0" Click="Uninstall_Click" />
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="100" Height="38" Margin="8,0,0,0" Click="Cancel_Click" />
                <Button x:Name="InstallButton" DockPanel.Dock="Right" Content="Install / Update" IsDefault="True" MinWidth="140" Height="38" Click="Install_Click" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
